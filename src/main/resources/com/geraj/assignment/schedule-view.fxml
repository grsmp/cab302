<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.geraj.assignment.controller.ScheduleController"
            style="-fx-background-color: #FFFFFF;">
    <top>
        <fx:include source="nav-bar.fxml"/>
    </top>

    <center>
        <VBox>

            <!-- HEADER -->
            <VBox spacing="14.0"
                  style="-fx-background-color: #F7F6F2;">

                <padding>
                    <Insets top="24.0" right="40.0" bottom="24.0" left="40.0"/>
                </padding>

                <Hyperlink text="&#8592; Back"
                           onAction="#onBack"
                           style="-fx-font-size: 12; -fx-text-fill: #5C5A54;"/>

                <HBox alignment="CENTER_LEFT" spacing="14.0">

                    <StackPane prefWidth="48.0"
                               prefHeight="48.0"
                               maxWidth="48.0"
                               maxHeight="48.0"
                               style="-fx-background-color: #1E1E1E; -fx-background-radius: 24;">
                        <Label text="&#128197;" style="-fx-font-size: 20;"/>
                    </StackPane>

                    <VBox spacing="2.0">
                        <Label text="Garden Schedule"
                               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>
                        <Label text="Keep track of watering, feeding, and maintenance tasks."
                               style="-fx-font-size: 13; -fx-text-fill: #8A8880;"/>
                    </VBox>

                </HBox>

            </VBox>

            <!-- CALENDAR -->
            <VBox spacing="16.0"
                  VBox.vgrow="ALWAYS">

                <padding>
                    <Insets top="24.0" right="40.0" bottom="30.0" left="40.0"/>
                </padding>

                <HBox alignment="CENTER" spacing="16.0">

                    <Button text="&#8249;"
                            onAction="#onPreviousMonth"
                            prefWidth="36.0"
                            prefHeight="36.0"
                            style="-fx-background-color: white; -fx-text-fill: #1E1E1E; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 18; -fx-border-color: #C9C7C0; -fx-border-radius: 18;"/>

                    <Label fx:id="monthYearLabel"
                           text="Month Year"
                           alignment="CENTER"
                           maxWidth="Infinity"
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>

                    <Button text="&#8250;"
                            onAction="#onNextMonth"
                            prefWidth="36.0"
                            prefHeight="36.0"
                            style="-fx-background-color: white; -fx-text-fill: #1E1E1E; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 18; -fx-border-color: #C9C7C0; -fx-border-radius: 18;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="+ Add Task"
                            onAction="#onAddTask"
                            prefHeight="36.0"
                            style="-fx-background-color: #1E1E1E; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12; -fx-background-radius: 6; -fx-padding: 0 16 0 16;"/>

                </HBox>

                <GridPane fx:id="calendarGrid"
                          hgap="8.0"
                          vgap="8.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                    </columnConstraints>

                    <Label text="MON" GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #8A8880;"/>
                    <Label text="TUE" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #8A8880;"/>
                    <Label text="WED" GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #8A8880;"/>
                    <Label text="THU" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #8A8880;"/>
                    <Label text="FRI" GridPane.columnIndex="4" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #8A8880;"/>
                    <Label text="SAT" GridPane.columnIndex="5" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #8A8880;"/>
                    <Label text="SUN" GridPane.columnIndex="6" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #8A8880;"/>

                </GridPane>

            </VBox>

        </VBox>
    </center>
</BorderPane>
