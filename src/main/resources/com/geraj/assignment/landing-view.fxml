<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.geraj.assignment.controller.LandingController"
            style="-fx-background-color: #FFFFFF;">
    <top>
        <fx:include source="nav-bar.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">
            <VBox>

                <!-- HERO -->
                <VBox alignment="CENTER"
                      spacing="20.0"
                      style="-fx-background-color: #F7F6F2;">

                    <padding>
                        <Insets top="80.0" right="40.0" bottom="70.0" left="40.0"/>
                    </padding>

                    <StackPane prefWidth="80.0"
                               prefHeight="80.0"
                               maxWidth="80.0"
                               maxHeight="80.0"
                               style="-fx-background-color: #1E1E1E; -fx-background-radius: 40;">
                        <Label text="&#127793;" style="-fx-font-size: 32;"/>
                    </StackPane>

                    <Label text="Plan Your Garden"
                           style="-fx-font-size: 40; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>

                    <Label text="Organise plots, crops, and schedules — all in one place."
                           wrapText="true"
                           maxWidth="480.0"
                           textAlignment="CENTER"
                           style="-fx-font-size: 15; -fx-text-fill: #5C5A54;"/>

                    <HBox alignment="CENTER"
                          spacing="16.0">
                        <VBox.margin>
                            <Insets top="12.0"/>
                        </VBox.margin>

                        <Button text="Create Account"
                                prefWidth="190.0"
                                prefHeight="44.0"
                                onAction="#onCreateAccount"
                                style="-fx-background-color: #1E1E1E; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6;"/>

                        <Button text="Sign In"
                                prefWidth="190.0"
                                prefHeight="44.0"
                                onAction="#onSignIn"
                                style="-fx-background-color: white; -fx-text-fill: #1E1E1E; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6; -fx-border-color: #1E1E1E; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                    </HBox>

                </VBox>

                <!-- FEATURES -->
                <HBox alignment="CENTER"
                      spacing="28.0">

                    <padding>
                        <Insets top="60.0" right="60.0" bottom="70.0" left="60.0"/>
                    </padding>

                    <VBox alignment="CENTER"
                          spacing="10.0"
                          maxWidth="240.0"
                          style="-fx-background-color: #FAFAF8; -fx-border-color: #E5E3DD; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <padding>
                            <Insets top="28.0" right="20.0" bottom="28.0" left="20.0"/>
                        </padding>

                        <Label text="&#127950;" style="-fx-font-size: 30;"/>
                        <Label text="Plan Plots"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>
                        <Label text="Map out garden beds and assign what grows where."
                               wrapText="true"
                               textAlignment="CENTER"
                               style="-fx-font-size: 12; -fx-text-fill: #8A8880;"/>
                    </VBox>

                    <VBox alignment="CENTER"
                          spacing="10.0"
                          maxWidth="240.0"
                          style="-fx-background-color: #FAFAF8; -fx-border-color: #E5E3DD; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <padding>
                            <Insets top="28.0" right="20.0" bottom="28.0" left="20.0"/>
                        </padding>

                        <Label text="&#127807;" style="-fx-font-size: 30;"/>
                        <Label text="Track Crops"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>
                        <Label text="Keep tabs on growth stages, harvests, and yields."
                               wrapText="true"
                               textAlignment="CENTER"
                               style="-fx-font-size: 12; -fx-text-fill: #8A8880;"/>
                    </VBox>

                    <VBox alignment="CENTER"
                          spacing="10.0"
                          maxWidth="240.0"
                          style="-fx-background-color: #FAFAF8; -fx-border-color: #E5E3DD; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <padding>
                            <Insets top="28.0" right="20.0" bottom="28.0" left="20.0"/>
                        </padding>

                        <Label text="&#128197;" style="-fx-font-size: 30;"/>
                        <Label text="Schedule Tasks"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>
                        <Label text="Set watering, feeding, and maintenance reminders."
                               wrapText="true"
                               textAlignment="CENTER"
                               style="-fx-font-size: 12; -fx-text-fill: #8A8880;"/>
                    </VBox>

                </HBox>

                <!-- FOOTER -->
                <VBox alignment="CENTER"
                      style="-fx-background-color: #F7F6F2;">
                    <padding>
                        <Insets top="20.0" bottom="20.0"/>
                    </padding>

                    <Label text="Community Garden — CAB302 GERAJ Application"
                           style="-fx-font-size: 11; -fx-text-fill: #A6A49C;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>