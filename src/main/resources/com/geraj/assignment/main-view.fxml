<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.geraj.assignment.controller.MainController"
            style="-fx-background-color: #FFFFFF;">
    <top>
        <fx:include source="nav-bar.fxml"/>
    </top>

    <center>
        <VBox>

            <!-- HERO -->
            <VBox alignment="CENTER"
                  spacing="16.0"
                  style="-fx-background-color: #F7F6F2;">

                <padding>
                    <Insets top="60.0" right="40.0" bottom="50.0" left="40.0"/>
                </padding>

                <StackPane prefWidth="72.0"
                           prefHeight="72.0"
                           maxWidth="72.0"
                           maxHeight="72.0"
                           style="-fx-background-color: #1E1E1E; -fx-background-radius: 36;">
                    <Label text="&#127807;" style="-fx-font-size: 28;"/>
                </StackPane>

                <Label text="GERAJ Community Garden"
                       style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>

                <Label text="Welcome back — what would you like to do today?"
                       style="-fx-font-size: 14; -fx-text-fill: #5C5A54;"/>

            </VBox>

            <!-- MENU -->
            <VBox alignment="TOP_CENTER"
                  spacing="14.0">

                <padding>
                    <Insets top="40.0" right="40.0" bottom="60.0" left="40.0"/>
                </padding>

                <Button fx:id="viewGardensButton"
                        text="&#127793;   View Gardens"
                        prefWidth="360.0"
                        prefHeight="52.0"
                        alignment="CENTER_LEFT"
                        onAction="#onViewGardens"
                        style="-fx-background-color: #1E1E1E; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 8; -fx-padding: 0 0 0 20;"/>

                <Button fx:id="createGardenButton"
                        text="&#10133;   Create a Garden"
                        prefWidth="360.0"
                        prefHeight="52.0"
                        alignment="CENTER_LEFT"
                        onAction="#onCreateGarden"
                        style="-fx-background-color: white; -fx-text-fill: #1E1E1E; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 8; -fx-border-color: #C9C7C0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 0 0 0 20;"/>

                <Button fx:id="viewProfileButton"
                        text="&#128100;   Account Profile"
                        prefWidth="360.0"
                        prefHeight="52.0"
                        alignment="CENTER_LEFT"
                        onAction="#onViewProfile"
                        style="-fx-background-color: white; -fx-text-fill: #1E1E1E; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 8; -fx-border-color: #C9C7C0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 0 0 0 20;"/>

                <Region prefHeight="10.0"/>

                <Button fx:id="logoutButton"
                        text="&#8592;   Log Out"
                        prefWidth="360.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        onAction="#onLogout"
                        style="-fx-background-color: transparent; -fx-text-fill: #8A8880; -fx-font-size: 13; -fx-padding: 0 0 0 20;"/>

            </VBox>

        </VBox>
    </center>
</BorderPane>