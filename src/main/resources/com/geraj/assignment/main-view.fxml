<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.geraj.assignment.controller.MainController">
    <top>
        <fx:include source="nav-bar.fxml"/>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="20.0">

            <padding>
                <Insets top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

            <Label text="GERAJ Community Garden Application"/>

            <Label text="Main Menu"/>

            <Button fx:id="viewGardensButton"
                    text="View Gardens"
                    prefWidth="220.0"
                    onAction="#onViewGardens"/>

            <Button fx:id="createGardenButton"
                    text="Create a Garden"
                    prefWidth="220.0"
                    onAction="#onCreateGarden"/>

            <Button fx:id="viewProfileButton"
                    text="Account Profile"
                    prefWidth="220.0"
                    onAction="#onViewProfile"/>

            <Button fx:id="logoutButton"
                    text="Log Out"
                    prefWidth="220.0"
                    onAction="#onLogout"/>

        </VBox>
    </center>
</BorderPane>