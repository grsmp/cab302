<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.geraj.assignment.controller.SignInController"
            style="-fx-background-color: #FFFFFF;">
    <top>
        <fx:include source="nav-bar.fxml"/>
    </top>
    <center>
        <HBox>

            <!-- LEFT PANEL: Branding -->
            <VBox prefWidth="380.0"
                  spacing="24.0"
                  style="-fx-background-color: #F7F6F2;">

                <padding>
                    <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
                </padding>

                <StackPane prefWidth="120.0"
                           prefHeight="120.0"
                           maxWidth="120.0"
                           maxHeight="120.0"
                           style="-fx-border-color: #C9C7C0; -fx-border-style: dashed; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="LOGO&#10;PLACEHOLDER"
                           textAlignment="CENTER"
                           style="-fx-text-alignment: center; -fx-font-size: 10; -fx-text-fill: #8A8880;"/>
                </StackPane>

                <Label text="Plan Your Garden"
                       wrapText="true"
                       style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>

                <Label text="Organise plots, crops, and schedules in one place."
                       wrapText="true"
                       style="-fx-font-size: 14; -fx-text-fill: #5C5A54;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <StackPane prefHeight="220.0"
                           style="-fx-border-color: #C9C7C0; -fx-border-style: dashed; -fx-background-color: #EFEEE9; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="Garden illustration"
                           style="-fx-text-fill: #A6A49C; -fx-font-size: 12;"/>
                </StackPane>

            </VBox>

            <!-- RIGHT PANEL: Sign In form -->
            <VBox alignment="TOP_CENTER"
                  spacing="16.0"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #FFFFFF;">

                <padding>
                    <Insets top="60.0" right="60.0" bottom="40.0" left="60.0"/>
                </padding>

                <StackPane prefWidth="56.0"
                           prefHeight="56.0"
                           maxWidth="56.0"
                           maxHeight="56.0"
                           style="-fx-border-color: #1E1E1E; -fx-border-radius: 28; -fx-background-radius: 28;">
                    <Label text="&#128274;" style="-fx-font-size: 20;"/>
                </StackPane>

                <Label text="Welcome Back"
                       style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>

                <Label text="Sign in to continue to Community Garden."
                       style="-fx-font-size: 13; -fx-text-fill: #8A8880;"/>

                <VBox spacing="6.0" maxWidth="340.0">

                    <Label text="Email"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;"/>

                    <TextField fx:id="usernameTextField"
                               promptText="you@example.com"
                               prefWidth="340.0"
                               prefHeight="38.0"/>

                    <Label text="Password"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1E1E1E;">
                        <VBox.margin>
                            <Insets top="10.0"/>
                        </VBox.margin>
                    </Label>

                    <PasswordField fx:id="passwordField"
                                   promptText="Password"
                                   prefWidth="340.0"
                                   prefHeight="38.0"/>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox.margin>
                            <Insets top="8.0"/>
                        </VBox.margin>

                        <CheckBox text="Remember me" style="-fx-font-size: 12;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Hyperlink text="Forgot password?" style="-fx-font-size: 12;"/>
                    </HBox>

                    <Label fx:id="messageLabel"
                           textFill="RED"
                           wrapText="true">
                        <VBox.margin>
                            <Insets top="4.0"/>
                        </VBox.margin>
                    </Label>

                    <Button fx:id="signInButton"
                            text="Sign In"
                            prefWidth="340.0"
                            prefHeight="40.0"
                            onAction="#onSignIn"
                            style="-fx-background-color: #1E1E1E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;">
                        <VBox.margin>
                            <Insets top="12.0"/>
                        </VBox.margin>
                    </Button>

                    <HBox alignment="CENTER" spacing="10.0">
                        <VBox.margin>
                            <Insets top="16.0"/>
                        </VBox.margin>

                        <Separator HBox.hgrow="ALWAYS"/>
                        <Label text="or" style="-fx-text-fill: #8A8880; -fx-font-size: 12;"/>
                        <Separator HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox alignment="CENTER" spacing="4.0">
                        <VBox.margin>
                            <Insets top="16.0"/>
                        </VBox.margin>

                        <Label text="Don't have an account?"
                               style="-fx-font-size: 12; -fx-text-fill: #5C5A54;"/>

                        <Hyperlink text="Sign Up"
                                   style="-fx-font-size: 12;"
                                   onAction="#onBack"/>
                    </HBox>

                </VBox>

            </VBox>

        </HBox>
    </center>
</BorderPane>