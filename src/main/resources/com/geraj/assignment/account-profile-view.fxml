<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.geraj.assignment.controller.ProfileController">
    <top>
        <fx:include source="nav-bar.fxml"/>
    </top>

    <left>
        <VBox prefWidth="190.0"
              spacing="8.0"
              style="-fx-background-color: #f7f8f6; -fx-border-color: #dddddd; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="24.0" left="16.0" right="16.0" top="24.0"/>
            </padding>
            <Label style="-fx-font-size: 12px; -fx-text-fill: #6c756e;"
                   text="ACCOUNT"/>
            <Button disable="true"
                    maxWidth="Infinity"
                    mnemonicParsing="false"
                    style="-fx-background-color: #dceee3; -fx-text-fill: #24633d;"
                    text="Profile"/>
            <Button disable="true" maxWidth="Infinity" mnemonicParsing="false" text="Security"/>
            <Button disable="true" maxWidth="Infinity" mnemonicParsing="false" text="Reminders"/>
            <Button disable="true" maxWidth="Infinity" mnemonicParsing="false" text="My gardens"/>
            <Button disable="true" maxWidth="Infinity" mnemonicParsing="false" text="Log out"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="26.0"/>
            </padding>

            <VBox spacing="4.0">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;"
                       text="Profile"/>
                <Label style="-fx-text-fill: #6c756e;"
                       text="View your account details and contribution history."/>
            </VBox>

            <VBox spacing="12.0"
                  style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-radius: 4; -fx-background-radius: 4;">
                <padding>
                    <Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/>
                </padding>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;"
                       text="Account overview"/>
                <HBox spacing="8.0">
                    <Label text="Username:"/>
                    <Label fx:id="usernameLabel" style="-fx-font-weight: bold;" text="—"/>
                </HBox>
                <GridPane hgap="12.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.333"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.334"/>
                    </columnConstraints>
                    <VBox spacing="4.0" style="-fx-background-color: #f3f4ef; -fx-padding: 12;" GridPane.columnIndex="0">
                        <Label text="Crops contributed"/>
                        <Label fx:id="cropsContributedLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0"/>
                    </VBox>
                    <VBox spacing="4.0" style="-fx-background-color: #f3f4ef; -fx-padding: 12;" GridPane.columnIndex="1">
                        <Label text="Watering shifts done"/>
                        <Label fx:id="wateringShiftsDoneLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0"/>
                    </VBox>
                    <VBox spacing="4.0" style="-fx-background-color: #f3f4ef; -fx-padding: 12;" GridPane.columnIndex="2">
                        <Label text="Harvests logged"/>
                        <Label fx:id="harvestsLoggedLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="0"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="14.0"
                  style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-radius: 4; -fx-background-radius: 4;">
                <padding>
                    <Insets bottom="18.0" left="18.0" right="18.0" top="16.0"/>
                </padding>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;"
                       text="Your details"/>
                <GridPane hgap="20.0" vgap="7.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>

                    <Label text="First name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Last name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <TextField fx:id="firstNameTextField" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="lastNameTextField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label fx:id="firstNameErrorLabel"
                           style="-fx-text-fill: #b42318;"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>
                    <Label fx:id="lastNameErrorLabel"
                           style="-fx-text-fill: #b42318;"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                    <Label text="Email" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label text="Phone" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <TextField fx:id="emailTextField" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="phoneNumberTextField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label fx:id="emailErrorLabel"
                           style="-fx-text-fill: #b42318;"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="5"/>
                    <Label fx:id="phoneNumberErrorLabel"
                           style="-fx-text-fill: #b42318;"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="5"/>
                </GridPane>

                <Separator/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button fx:id="saveChangesButton"
                            mnemonicParsing="false"
                            onAction="#saveChanges"
                            style="-fx-background-color: #28784a; -fx-text-fill: white;"
                            text="Save changes"/>
                    <Button fx:id="cancelChangesButton"
                            mnemonicParsing="false"
                            onAction="#cancelChanges"
                            text="Cancel"/>
                    <Label fx:id="messageLabel"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="unsavedChangesLabel"
                           style="-fx-text-fill: #8a5a00;"
                           text=""/>
                </HBox>
            </VBox>

            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;"
                       text="Garden memberships"/>
                <ListView fx:id="gardenMembershipsListView" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No garden memberships to display."/>
                    </placeholder>
                </ListView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
